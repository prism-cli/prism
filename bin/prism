#!/usr/bin/env bash
set -euo pipefail

# Dynamically resolve the Prism root directory (parent of bin/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRISM_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
PRISM_VERSION="0.1.0"

# --- ANSI Color Palette ---
C_YELLOW="\033[33;1m"
C_CYAN="\033[36;1m"
C_GREEN="\033[32;1m"
C_RED="\033[31;1m"
C_DIM="\033[90m"
C_BOLD="\033[1m"
C_RESET="\033[0m"

SUPPORTED_PROVIDERS=("gemini" "claude" "codex" "grok" "cursor")

# Dot leader helper (auto-fills dots between left and right column)
dot_leader() {
  local left="$1"
  local right_text="$2"
  local right_colored="$3"
  local width=72
  local total_len=$(( ${#left} + ${#right_text} + 4 ))
  local dot_count=$(( width - total_len ))
  if (( dot_count < 2 )); then dot_count=2; fi
  local dots
  dots=$(printf '%*s' "$dot_count" '' | tr ' ' '.')
  echo -e "  ${left} ${C_DIM}${dots}${C_RESET} ${right_colored}"
}

# Convert absolute path to ~/relative for clean display
clean_path() {
  local path="$1"
  if [[ "$path" == "$HOME"* ]]; then
    echo "~${path#$HOME}"
  else
    echo "$path"
  fi
}

# --- Provider Target Root Mapping & Aliases ---
resolve_provider() {
  case "$1" in
    gemini|antigravity|g|agy) echo "gemini" ;;
    claude|c)                 echo "claude" ;;
    codex|cx|co)              echo "codex" ;;
    grok|gk|x)                echo "grok" ;;
    cursor|cr|cs)             echo "cursor" ;;
    all|a)                    echo "all" ;;
    *)                        echo "$1" ;;
  esac
}

get_provider_root() {
  local p
  p="$(resolve_provider "$1")"
  case "$p" in
    gemini) echo ".agents" ;;
    claude) echo ".claude" ;;
    codex)  echo ".codex" ;;
    grok)   echo ".grok" ;;
    cursor) echo ".cursor" ;;
    *)      echo "" ;;
  esac
}

get_project_root() {
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
  else
    pwd
  fi
}

count_items() {
  local dir="$1"
  local type="${2:-f}"
  if [[ -d "$dir" ]]; then
    if [[ "$type" == "d" ]]; then
      find "$dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' '
    else
      find "$dir" -maxdepth 1 -name "*.md" 2>/dev/null | wc -l | tr -d ' '
    fi
  else
    echo "0"
  fi
}

# --- Git Stealth Protection (Silent Default) ---
ensure_git_excluded() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -d "$project_root/.git" ]]; then
    mkdir -p "$(dirname "$exclude_file")"
    if ! grep -qs "^${target_rel}" "$exclude_file" 2>/dev/null; then
      echo "" >> "$exclude_file"
      echo "# [prism] Local developer AI preferences (untracked)" >> "$exclude_file"
      echo "${target_rel}/" >> "$exclude_file"
      echo "${target_rel}" >> "$exclude_file"
    fi
  fi
}

remove_git_exclusion() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -f "$exclude_file" ]]; then
    sed -i.bak "/# \[prism\]/d" "$exclude_file" 2>/dev/null || true
    sed -i.bak "\|^${target_rel}/?\$|d" "$exclude_file" 2>/dev/null || true
    rm -f "${exclude_file}.bak"
  fi
}

# Link a single category (agents or skills) safely
safe_link_dir() {
  local src="$1"
  local dest="$2"

  mkdir -p "$(dirname "$dest")"

  if [[ -L "$dest" ]]; then
    local current
    current="$(readlink "$dest")"
    if [[ "$current" != "$src" ]]; then
      ln -sfn "$src" "$dest"
    fi
  elif [[ -d "$dest" ]]; then
    for item in "$src"/*; do
      if [[ -e "$item" ]]; then
        local iname
        iname="$(basename "$item")"
        if [[ ! -e "$dest/$iname" ]]; then
          ln -s "$item" "$dest/$iname"
        fi
      fi
    done
  else
    ln -s "$src" "$dest"
  fi
}

# --- Command: Apply Single Provider ---
apply_provider() {
  local provider
  provider="$(resolve_provider "$1")"
  local p_root
  p_root="$(get_provider_root "$provider")"

  if [[ -z "$p_root" ]]; then
    dot_leader "$provider" "unknown provider" "${C_RED}unknown provider${C_RESET}"
    return 1
  fi

  local project_root
  project_root="$(get_project_root)"

  local agents_src="$PRISM_HOME/agents"
  local skills_src="$PRISM_HOME/skills"

  local agents_dest="$project_root/$p_root/agents"
  local skills_dest="$project_root/$p_root/skills"

  if [[ -d "$agents_src" ]]; then
    safe_link_dir "$agents_src" "$agents_dest"
    if [[ "$provider" == "cursor" ]]; then
      safe_link_dir "$agents_src" "$project_root/$p_root/rules"
    fi
  fi

  if [[ -d "$skills_src" ]]; then
    safe_link_dir "$skills_src" "$skills_dest"
  fi

  ensure_git_excluded "$project_root" "$p_root"

  local a_count s_count
  a_count=$(count_items "$agents_src" "f")
  s_count=$(count_items "$skills_src" "d")

  local raw_right="active (${a_count} agents, ${s_count} skills)"
  local colored_right="${C_GREEN}active${C_RESET} ${C_DIM}(${a_count} agents, ${s_count} skills)${C_RESET}"
  dot_leader "$provider" "$raw_right" "$colored_right"
}

cmd_apply() {
  local target_provider
  target_provider="$(resolve_provider "${1:-all}")"
  local project_root
  project_root="$(get_project_root)"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${C_BOLD}Applying prism to${C_RESET} ${display_root}\n"

  if [[ "$target_provider" == "all" || "$target_provider" == "--all" ]]; then
    for p in "${SUPPORTED_PROVIDERS[@]}"; do
      apply_provider "$p"
    done
  else
    apply_provider "$target_provider"
  fi
  echo ""
}

# --- Command: Status ---
cmd_status() {
  local project_root
  project_root="$(get_project_root)"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${C_BOLD}Prism status in${C_RESET} ${display_root}\n"

  local a_count s_count
  a_count=$(count_items "$PRISM_HOME/agents" "f")
  s_count=$(count_items "$PRISM_HOME/skills" "d")

  for p in "${SUPPORTED_PROVIDERS[@]}"; do
    local p_root
    p_root="$(get_provider_root "$p")"
    local a_dest="$project_root/$p_root/agents"
    local s_dest="$project_root/$p_root/skills"

    if [[ -e "$a_dest" || -e "$s_dest" ]]; then
      local raw_right="active (${a_count} agents, ${s_count} skills)"
      local colored_right="${C_GREEN}active${C_RESET} ${C_DIM}(${a_count} agents, ${s_count} skills)${C_RESET}"
      dot_leader "$p" "$raw_right" "$colored_right"
    else
      dot_leader "$p" "inactive" "${C_DIM}inactive${C_RESET}"
    fi
  done
  echo ""
}

# --- Command: Clean Single Provider ---
clean_provider() {
  local provider
  provider="$(resolve_provider "$1")"
  local p_root
  p_root="$(get_provider_root "$provider")"

  if [[ -z "$p_root" ]]; then
    dot_leader "$provider" "unknown provider" "${C_RED}unknown provider${C_RESET}"
    return 1
  fi

  local project_root
  project_root="$(get_project_root)"

  local a_dest="$project_root/$p_root/agents"
  local s_dest="$project_root/$p_root/skills"

  local removed=0

  if [[ -L "$a_dest" ]]; then rm "$a_dest"; removed=1; elif [[ -d "$a_dest" ]]; then find "$a_dest" -type l -exec rm {} +; removed=1; fi
  if [[ -L "$s_dest" ]]; then rm "$s_dest"; removed=1; elif [[ -d "$s_dest" ]]; then find "$s_dest" -type l -exec rm {} +; removed=1; fi
  if [[ "$provider" == "cursor" ]]; then
    local r_dest="$project_root/$p_root/rules"
    if [[ -L "$r_dest" ]]; then rm "$r_dest"; removed=1; elif [[ -d "$r_dest" ]]; then find "$r_dest" -type l -exec rm {} +; removed=1; fi
  fi

  rmdir "$project_root/$p_root" 2>/dev/null || true
  remove_git_exclusion "$project_root" "$p_root"

  if [[ $removed -eq 1 ]]; then
    dot_leader "$provider" "cleaned" "${C_DIM}cleaned${C_RESET}"
  else
    dot_leader "$provider" "clean" "${C_DIM}clean${C_RESET}"
  fi
}

cmd_clean() {
  local target_provider
  target_provider="$(resolve_provider "${1:-all}")"
  local project_root
  project_root="$(get_project_root)"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${C_BOLD}Cleaning prism from${C_RESET} ${display_root}\n"

  if [[ "$target_provider" == "all" || "$target_provider" == "--all" ]]; then
    for p in "${SUPPORTED_PROVIDERS[@]}"; do
      clean_provider "$p"
    done
  else
    clean_provider "$target_provider"
  fi
  echo ""
}

# --- Command: List Agents & Skills ---
cmd_list() {
  local agents_dir="$PRISM_HOME/agents"
  local skills_dir="$PRISM_HOME/skills"

  echo -e "\n${C_BOLD}Agents in${C_RESET} ${C_DIM}$(clean_path "$agents_dir")${C_RESET}\n"
  if [[ -d "$agents_dir" ]]; then
    for f in "$agents_dir"/*.md; do
      if [[ -f "$f" ]]; then
        local base name
        base="$(basename "$f")"
        name=$(grep -E "^name:" "$f" 2>/dev/null | head -n1 | sed -E 's/name:[[:space:]]*//' || echo "$base")
        dot_leader "$name" "$base" "${C_DIM}${base}${C_RESET}"
      fi
    done
  fi

  echo -e "\n${C_BOLD}Skills in${C_RESET} ${C_DIM}$(clean_path "$skills_dir")${C_RESET}\n"
  if [[ -d "$skills_dir" ]]; then
    for d in "$skills_dir"/*; do
      if [[ -d "$d" ]]; then
        local sname
        sname="$(basename "$d")"
        dot_leader "$sname" "SKILL.md" "${C_DIM}SKILL.md${C_RESET}"
      fi
    done
  fi
  echo ""
}

# --- Command: Install (Binary Symlink + Aliases) ---
cmd_install() {
  local bin_path="$PRISM_HOME/bin/prism"
  chmod +x "$bin_path"

  echo -e "\n${C_BOLD}Prism installed${C_RESET}\n"

  # 1. Symlink binary according to Unix standard (XDG base directory / user-local bin)
  local local_bin="$HOME/.local/bin"
  mkdir -p "$local_bin"
  ln -sfn "$bin_path" "$local_bin/prism"
  dot_leader "bin" "$local_bin/prism" "${C_GREEN}${local_bin}/prism${C_RESET}"

  # 2. Shell aliases fallback & persistence
  local zsh_bash_alias="alias prism=\"$bin_path\""
  local fish_alias="alias prism '$bin_path'"

  # Zsh: alias + ensure ~/.local/bin in PATH
  local zshrc="$HOME/.zshrc"
  touch "$zshrc"
  sed -i.bak '/# Mindset CLI/d; /alias mindset=/d; /# Prism CLI/d; /alias prism=/d; /export PATH=.*\.local\/bin/d' "$zshrc" 2>/dev/null || true
  rm -f "${zshrc}.bak"
  {
    echo -e "\n# Prism CLI"
    echo '[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"'
    echo "$zsh_bash_alias"
  } >> "$zshrc"
  dot_leader "zsh" "~/.zshrc" "${C_DIM}~/.zshrc${C_RESET}"

  # Fish: alias + ensure ~/.local/bin in PATH
  local fish_conf="$HOME/.config/fish/config.fish"
  if [[ -d "$HOME/.config/fish" ]] || which fish >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/fish"
    touch "$fish_conf"
    sed -i.bak '/# Mindset CLI/d; /alias mindset/d; /# Prism CLI/d; /alias prism/d; /fish_add_path.*\.local\/bin/d' "$fish_conf" 2>/dev/null || true
    rm -f "${fish_conf}.bak"
    {
      echo -e "\n# Prism CLI"
      echo 'fish_add_path -a $HOME/.local/bin'
      echo "$fish_alias"
    } >> "$fish_conf"
    dot_leader "fish" "~/.config/fish/config.fish" "${C_DIM}~/.config/fish/config.fish${C_RESET}"
  fi
  echo ""
}

# --- Command: Uninstall (Remove Symlink & Aliases) ---
cmd_uninstall() {
  echo -e "\n${C_BOLD}Prism uninstalled${C_RESET}\n"

  # Remove symlinked binaries
  for dir in "/opt/homebrew/bin" "$HOME/.local/bin" "/usr/local/bin"; do
    if [[ -L "$dir/prism" ]]; then
      rm -f "$dir/prism"
      dot_leader "bin" "$dir/prism" "${C_DIM}removed${C_RESET}"
    fi
  done

  # Zsh
  local zshrc="$HOME/.zshrc"
  if [[ -f "$zshrc" ]]; then
    sed -i.bak '/# Prism CLI/d; /alias prism=/d; /# Mindset CLI/d; /alias mindset=/d' "$zshrc" 2>/dev/null || true
    rm -f "${zshrc}.bak"
    dot_leader "zsh" "removed" "${C_DIM}removed${C_RESET}"
  fi

  # Fish
  local fish_conf="$HOME/.config/fish/config.fish"
  if [[ -f "$fish_conf" ]]; then
    sed -i.bak '/# Prism CLI/d; /alias prism/d; /# Mindset CLI/d; /alias mindset/d' "$fish_conf" 2>/dev/null || true
    rm -f "${fish_conf}.bak"
    dot_leader "fish" "removed" "${C_DIM}removed${C_RESET}"
  fi

  # Bash
  for rc in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [[ -f "$rc" ]]; then
      sed -i.bak '/# Prism CLI/d; /alias prism=/d; /# Mindset CLI/d; /alias mindset=/d' "$rc" 2>/dev/null || true
      rm -f "${rc}.bak"
    fi
  done
  echo ""
}

# --- Help ---
show_help() {
  echo -e "\n${C_BOLD}Prism CLI${C_RESET} ${C_DIM}v${PRISM_VERSION}${C_RESET}"
  echo -e "  prism [provider]              ${C_DIM}Apply to project (default: all)   [apply]${C_RESET}"
  echo -e "  prism clean [provider]        ${C_DIM}Clean from project (default: all) [rm]${C_RESET}"
  echo -e "  prism status                  ${C_DIM}View status across providers      [st]${C_RESET}"
  echo -e "  prism list                    ${C_DIM}List all agents & skills          [ls, l]${C_RESET}"
  echo -e "  prism install                 ${C_DIM}Install shell aliases             [i]${C_RESET}"
  echo -e "  prism uninstall               ${C_DIM}Remove shell aliases              [ui]${C_RESET}"
  echo -e "  prism version                 ${C_DIM}Print version                     [-v, --version]${C_RESET}"
  echo -e "\n  ${C_BOLD}Shortcuts:${C_RESET}"
  echo -e "    ${C_CYAN}st${C_RESET} = status, ${C_CYAN}ls${C_RESET} = list, ${C_CYAN}clean${C_RESET} / ${C_CYAN}rm${C_RESET} = remove"
  echo -e "    ${C_CYAN}g${C_RESET} = gemini, ${C_CYAN}c${C_RESET} = claude, ${C_CYAN}cx${C_RESET} = codex, ${C_CYAN}gk${C_RESET} = grok, ${C_CYAN}cr${C_RESET} = cursor, ${C_CYAN}a${C_RESET} = all\n"
}

# --- CLI Router ---
case "${1:-}" in
  version|-v|--version|v)
    echo "prism v${PRISM_VERSION}"
    ;;
  install|i)
    cmd_install
    ;;
  uninstall|ui)
    cmd_uninstall
    ;;
  clean|rm|u|unsync|unlink)
    cmd_clean "${2:-all}"
    ;;
  status|st)
    cmd_status
    ;;
  list|ls|l|agents|skills)
    cmd_list
    ;;
  help|--help|-h|h)
    show_help
    ;;
  apply|link|sync|s)
    cmd_apply "${2:-all}"
    ;;
  gemini|antigravity|g|agy|claude|c|codex|cx|co|grok|gk|x|cursor|cr|cs|all|a)
    cmd_apply "$1"
    ;;
  "")
    cmd_apply "all"
    ;;
  *)
    echo -e "\n${C_RED}Unknown command or provider '$1'${C_RESET}"
    show_help
    exit 1
    ;;
esac
