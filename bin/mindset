#!/usr/bin/env bash
set -euo pipefail

# Dynamically resolve the Mindset root directory (parent of bin/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MINDSET_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

# --- Color Helpers ---
GREEN="\033[0;32m"
BLUE="\033[0;34m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
BOLD="\033[1m"
RESET="\033[0m"

log_ok()   { echo -e "${GREEN}✓${RESET} $1"; }
log_info() { echo -e "${BLUE}ℹ${RESET} $1"; }
log_warn() { echo -e "${YELLOW}⚠${RESET} $1"; }
log_err()  { echo -e "${RED}✗${RESET} $1"; }

# --- Provider Registry ---
# Maps provider name -> source directory and target relative path in project
get_provider_source() {
  case "$1" in
    antigravity) echo "$MINDSET_HOME/antigravity/agents" ;;
    cursor)      echo "$MINDSET_HOME/cursor/rules" ;;
    claude)      echo "$MINDSET_HOME/claude" ;;
    *)           echo "" ;;
  esac
}

get_provider_target() {
  case "$1" in
    antigravity) echo ".agents/agents" ;;
    cursor)      echo ".cursor/rules" ;;
    claude)      echo ".claude" ;;
    *)           echo "" ;;
  esac
}

# --- Find Git Root ---
get_project_root() {
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
  else
    pwd
  fi
}

# --- Git Ignore Protection ---
ensure_git_excluded() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -d "$project_root/.git" ]]; then
    mkdir -p "$(dirname "$exclude_file")"
    if ! grep -qs "^${target_rel}$" "$exclude_file" 2>/dev/null; then
      echo "" >> "$exclude_file"
      echo "# [mindset] Local developer AI preferences (untracked)" >> "$exclude_file"
      echo "$target_rel" >> "$exclude_file"
      log_ok "Stealth mode: Added ${BOLD}${target_rel}${RESET} to .git/info/exclude"
    else
      log_info "${target_rel} is already in .git/info/exclude"
    fi
  else
    log_warn "Not a git repository. Remember to exclude '${target_rel}' if you initialize git."
  fi
}

remove_git_exclusion() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -f "$exclude_file" ]]; then
    sed -i.bak "/# \[mindset\]/d" "$exclude_file" 2>/dev/null || true
    sed -i.bak "\|^${target_rel}\$|d" "$exclude_file" 2>/dev/null || true
    rm -f "${exclude_file}.bak"
    log_ok "Removed ${target_rel} from .git/info/exclude"
  fi
}

# --- Command: Link Provider ---
cmd_link() {
  local provider="${1:-antigravity}"
  local source_dir
  local target_rel
  local project_root
  local target_dir

  source_dir="$(get_provider_source "$provider")"
  target_rel="$(get_provider_target "$provider")"

  if [[ -z "$source_dir" ]]; then
    log_err "Unknown provider: '$provider'. Supported providers: antigravity, cursor, claude"
    exit 1
  fi

  if [[ ! -d "$source_dir" ]]; then
    log_err "Source directory does not exist: $source_dir"
    log_info "Creating empty source directory at $source_dir..."
    mkdir -p "$source_dir"
  fi

  project_root="$(get_project_root)"
  target_dir="$project_root/$target_rel"

  echo -e "\n${BOLD}Applying Mindset (${provider})${RESET} to: ${BLUE}$project_root${RESET}"

  # Ensure parent directory exists (e.g. .agents/)
  mkdir -p "$(dirname "$target_dir")"

  # Safe collision detection
  if [[ -L "$target_dir" ]]; then
    local current_target
    current_target="$(readlink "$target_dir")"
    if [[ "$current_target" == "$source_dir" ]]; then
      log_ok "Already linked to mindset: $target_rel -> $source_dir"
    else
      log_warn "Symlink exists pointing to '$current_target'."
      ln -sfn "$source_dir" "$target_dir"
      log_ok "Updated symlink: $target_rel -> $source_dir"
    fi
  elif [[ -d "$target_dir" ]]; then
    log_warn "Destination '$target_rel' is an existing directory with local project files."
    log_info "Safely linking individual files inside so existing files are NOT overwritten..."
    for file in "$source_dir"/*; do
      if [[ -f "$file" ]]; then
        local fname
        fname="$(basename "$file")"
        if [[ -e "$target_dir/$fname" ]]; then
          log_warn "Skipped '$fname': file already exists locally in project."
        else
          ln -s "$file" "$target_dir/$fname"
          log_ok "Linked file: $fname"
        fi
      fi
    done
  else
    ln -s "$source_dir" "$target_dir"
    log_ok "Linked: $target_rel -> $source_dir"
  fi

  # Apply Git stealth ignore
  ensure_git_excluded "$project_root" "$target_rel"

  echo -e "${GREEN}${BOLD}Mindset active for ${provider}!${RESET}\n"
}

# --- Command: Unlink Provider ---
cmd_unlink() {
  local provider="${1:-antigravity}"
  local target_rel
  local project_root
  local target_dir

  target_rel="$(get_provider_target "$provider")"
  project_root="$(get_project_root)"
  target_dir="$project_root/$target_rel"

  echo -e "\n${BOLD}Unlinking Mindset (${provider})${RESET} from: ${BLUE}$project_root${RESET}"

  if [[ -L "$target_dir" ]]; then
    rm "$target_dir"
    log_ok "Removed symlink: $target_rel"
    remove_git_exclusion "$project_root" "$target_rel"
  elif [[ -d "$target_dir" ]]; then
    find "$target_dir" -type l -exec rm {} +
    log_ok "Removed mindset symlinks inside: $target_rel"
    remove_git_exclusion "$project_root" "$target_rel"
  else
    log_info "No mindset symlink found at $target_rel"
  fi
  echo ""
}

# --- Command: Status ---
cmd_status() {
  local project_root
  project_root="$(get_project_root)"
  echo -e "\n${BOLD}Mindset status for:${RESET} ${BLUE}$project_root${RESET}\n"

  for p in antigravity cursor claude; do
    local target_rel target_dir
    target_rel="$(get_provider_target "$p")"
    target_dir="$project_root/$target_rel"
    if [[ -L "$target_dir" ]]; then
      echo -e "  • ${BOLD}$p${RESET}: ${GREEN}Linked${RESET} ($target_rel -> $(readlink "$target_dir"))"
    elif [[ -d "$target_dir" ]]; then
      echo -e "  • ${BOLD}$p${RESET}: ${YELLOW}Merged directory${RESET} ($target_rel)"
    else
      echo -e "  • ${BOLD}$p${RESET}: ${RED}Not linked${RESET}"
    fi
  done
  echo ""
}

# --- Command: Install (Fish, Bash, Zsh) ---
cmd_install() {
  local bin_path="$MINDSET_HOME/bin/mindset"
  chmod +x "$bin_path"
  log_ok "Made $bin_path executable."

  local zsh_bash_alias="alias mindset=\"$bin_path\""
  local fish_alias="alias mindset '$bin_path'"

  echo -e "\n${BOLD}Configuring shell aliases...${RESET}"

  # 1. Zsh (default on macOS)
  local zshrc="$HOME/.zshrc"
  touch "$zshrc"
  if ! grep -qs "alias mindset=" "$zshrc"; then
    echo -e "\n# Mindset CLI\n$zsh_bash_alias" >> "$zshrc"
    log_ok "Added alias to ~/.zshrc"
  else
    log_info "Alias already present in ~/.zshrc"
  fi

  # 2. Bash
  for rc in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [[ -f "$rc" ]]; then
      if ! grep -qs "alias mindset=" "$rc"; then
        echo -e "\n# Mindset CLI\n$zsh_bash_alias" >> "$rc"
        log_ok "Added alias to $rc"
      else
        log_info "Alias already present in $rc"
      fi
    fi
  done

  # 3. Fish Shell
  local fish_conf="$HOME/.config/fish/config.fish"
  if [[ -d "$HOME/.config/fish" ]] || which fish >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/fish"
    touch "$fish_conf"
    if ! grep -qs "alias mindset" "$fish_conf"; then
      echo -e "\n# Mindset CLI\n$fish_alias" >> "$fish_conf"
      log_ok "Added alias to ~/.config/fish/config.fish"
    else
      log_info "Alias already present in ~/.config/fish/config.fish"
    fi
  fi

  echo -e "\n${GREEN}${BOLD}Installation complete!${RESET}"
  echo -e "To start using ${BOLD}mindset${RESET}, reload your shell:"
  echo -e "  ${BLUE}source ~/.zshrc${RESET}               (Zsh)"
  echo -e "  ${BLUE}source ~/.config/fish/config.fish${RESET} (Fish)\n"
}

# --- Usage Help ---
show_help() {
  echo -e "${BOLD}Mindset CLI${RESET} - Inject your developer mindset into project AI assistants"
  echo ""
  echo "Usage:"
  echo "  mindset [provider]       Link a provider to current project (default: antigravity)"
  echo "  mindset link [provider]  Explicit link command"
  echo "  mindset unlink [provider] Remove provider symlinks from current project"
  echo "  mindset status           Check active mindset providers in current project"
  echo "  mindset install          Register shell aliases (Bash, Zsh, Fish)"
  echo "  mindset help             Show this help menu"
  echo ""
  echo "Supported providers: antigravity, cursor, claude"
  echo ""
}

# --- CLI Router ---
case "${1:-}" in
  install)
    cmd_install
    ;;
  unlink)
    cmd_unlink "${2:-antigravity}"
    ;;
  status)
    cmd_status
    ;;
  help|--help|-h)
    show_help
    ;;
  antigravity|cursor|claude)
    cmd_link "$1"
    ;;
  link)
    cmd_link "${2:-antigravity}"
    ;;
  "")
    cmd_link "antigravity"
    ;;
  *)
    log_err "Unknown command or provider: '$1'"
    show_help
    exit 1
    ;;
esac
