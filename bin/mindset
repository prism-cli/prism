#!/usr/bin/env bash
set -euo pipefail

# Dynamically resolve the Mindset root directory (parent of bin/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MINDSET_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

# --- ANSI Color Palette ---
C_YELLOW="\033[33;1m"
C_CYAN="\033[36;1m"
C_GREEN="\033[32;1m"
C_RED="\033[31;1m"
C_DIM="\033[90m"
C_BOLD="\033[1m"
C_RESET="\033[0m"

# Formatting helpers
sym_bolt="${C_YELLOW}⚡${C_RESET}"
sym_node="${C_CYAN}◈${C_RESET}"
sym_active="${C_DIM}──${C_RESET}${C_GREEN}●${C_RESET}"
sym_inactive="${C_DIM}──○${C_RESET}"

# Convert absolute path to ~/relative for clean display
clean_path() {
  local path="$1"
  if [[ "$path" == "$HOME"* ]]; then
    echo "~${path#$HOME}"
  else
    echo "$path"
  fi
}

# --- Provider Registry ---
get_provider_source() {
  case "$1" in
    antigravity) echo "$MINDSET_HOME/antigravity/agents" ;;
    cursor)      echo "$MINDSET_HOME/cursor/rules" ;;
    claude)      echo "$MINDSET_HOME/claude" ;;
    *)           echo "" ;;
  esac
}

get_provider_target() {
  case "$1" in
    antigravity) echo ".agents/agents" ;;
    cursor)      echo ".cursor/rules" ;;
    claude)      echo ".claude" ;;
    *)           echo "" ;;
  esac
}

get_project_root() {
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
  else
    pwd
  fi
}

count_agents() {
  local dir="$1"
  if [[ -d "$dir" ]]; then
    local count
    count=$(find "$dir" -maxdepth 1 -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
    echo "$count"
  else
    echo "0"
  fi
}

# --- Git Stealth Protection (Silent Default) ---
ensure_git_excluded() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -d "$project_root/.git" ]]; then
    mkdir -p "$(dirname "$exclude_file")"
    if ! grep -qs "^${target_rel}$" "$exclude_file" 2>/dev/null; then
      echo "" >> "$exclude_file"
      echo "# [mindset] Local developer AI preferences (untracked)" >> "$exclude_file"
      echo "$target_rel" >> "$exclude_file"
    fi
  fi
}

remove_git_exclusion() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -f "$exclude_file" ]]; then
    sed -i.bak "/# \[mindset\]/d" "$exclude_file" 2>/dev/null || true
    sed -i.bak "\|^${target_rel}\$|d" "$exclude_file" 2>/dev/null || true
    rm -f "${exclude_file}.bak"
  fi
}

# --- Command: Sync Provider ---
cmd_sync() {
  local provider="${1:-antigravity}"
  local source_dir
  local target_rel
  local project_root
  local target_dir

  source_dir="$(get_provider_source "$provider")"
  target_rel="$(get_provider_target "$provider")"

  if [[ -z "$source_dir" ]]; then
    echo -e "${sym_bolt} ${C_RED}Unknown provider '${provider}'${C_RESET}\n"
    exit 1
  fi

  if [[ ! -d "$source_dir" ]]; then
    mkdir -p "$source_dir"
  fi

  project_root="$(get_project_root)"
  target_dir="$project_root/$target_rel"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${sym_bolt} ${C_BOLD}Syncing my mindset to${C_RESET} ${display_root}"

  mkdir -p "$(dirname "$target_dir")"

  local agent_count
  agent_count=$(count_agents "$source_dir")
  local agent_str="(${agent_count} agents)"
  if [[ "$agent_count" -eq 1 ]]; then agent_str="(1 agent)"; fi

  # Safe collision detection
  if [[ -L "$target_dir" ]]; then
    local current_target
    current_target="$(readlink "$target_dir")"
    if [[ "$current_target" == "$source_dir" ]]; then
      echo -e "  ${sym_node} ${provider} ${sym_active} ${C_GREEN}in sync${C_RESET} ${C_DIM}${agent_str}${C_RESET}\n"
    else
      ln -sfn "$source_dir" "$target_dir"
      echo -e "  ${sym_node} ${provider} ${sym_active} ${C_GREEN}synced${C_RESET} ${C_DIM}${agent_str}${C_RESET}\n"
    fi
  elif [[ -d "$target_dir" ]]; then
    # Merge mode without overwriting existing files
    local synced=0 preserved=0
    for file in "$source_dir"/*; do
      if [[ -f "$file" ]]; then
        local fname
        fname="$(basename "$file")"
        if [[ -e "$target_dir/$fname" ]]; then
          ((preserved++))
        else
          ln -s "$file" "$target_dir/$fname"
          ((synced++))
        fi
      fi
    done
    echo -e "  ${sym_node} ${provider} ${sym_active} ${C_GREEN}merged${C_RESET} ${C_DIM}(${synced} synced, ${preserved} local)${C_RESET}\n"
  else
    ln -s "$source_dir" "$target_dir"
    echo -e "  ${sym_node} ${provider} ${sym_active} ${C_GREEN}synced${C_RESET} ${C_DIM}${agent_str}${C_RESET}\n"
  fi

  # Silently apply Git exclusion
  ensure_git_excluded "$project_root" "$target_rel"
}

# --- Command: Status ---
cmd_status() {
  local project_root
  project_root="$(get_project_root)"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${sym_bolt} ${C_BOLD}My mindset status in${C_RESET} ${display_root}"

  for p in antigravity cursor claude; do
    local target_rel target_dir source_dir
    target_rel="$(get_provider_target "$p")"
    target_dir="$project_root/$target_rel"
    source_dir="$(get_provider_source "$p")"

    if [[ -L "$target_dir" ]]; then
      local agent_count
      agent_count=$(count_agents "$source_dir")
      echo -e "  ${sym_node} ${p} ${sym_active} ${C_GREEN}in sync${C_RESET} ${C_DIM}(${agent_count} agents)${C_RESET}"
    elif [[ -d "$target_dir" ]]; then
      echo -e "  ${sym_node} ${p} ${sym_active} ${C_YELLOW}merged${C_RESET}"
    else
      echo -e "  ${sym_node} ${p} ${sym_inactive} ${C_DIM}not synced${C_RESET}"
    fi
  done
  echo ""
}

# --- Command: Unsync Provider ---
cmd_unsync() {
  local provider="${1:-antigravity}"
  local target_rel
  local project_root
  local target_dir

  target_rel="$(get_provider_target "$provider")"
  project_root="$(get_project_root)"
  target_dir="$project_root/$target_rel"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${sym_bolt} ${C_BOLD}Unsyncing my mindset from${C_RESET} ${display_root}"

  if [[ -L "$target_dir" ]]; then
    rm "$target_dir"
    remove_git_exclusion "$project_root" "$target_rel"
    echo -e "  ${sym_node} ${provider} ${sym_inactive} ${C_DIM}unsynced${C_RESET}\n"
  elif [[ -d "$target_dir" ]]; then
    find "$target_dir" -type l -exec rm {} +
    remove_git_exclusion "$project_root" "$target_rel"
    echo -e "  ${sym_node} ${provider} ${sym_inactive} ${C_DIM}unsynced (cleaned merged)${C_RESET}\n"
  else
    echo -e "  ${sym_node} ${provider} ${sym_inactive} ${C_DIM}not synced${C_RESET}\n"
  fi
}

# --- Command: List Agents ---
cmd_list() {
  local display_vault
  display_vault="$(clean_path "$MINDSET_HOME/antigravity/agents")"

  echo -e "\n${sym_bolt} ${C_BOLD}Agents in${C_RESET} ${display_vault}"

  for f in "$MINDSET_HOME/antigravity/agents"/*.md; do
    if [[ -f "$f" ]]; then
      local base
      base="$(basename "$f")"
      local name
      name=$(grep -E "^name:" "$f" 2>/dev/null | head -n1 | sed -E 's/name:[[:space:]]*//' || echo "$base")
      echo -e "  ${sym_node} ${C_BOLD}${name}${C_RESET} ${C_DIM}── ${base}${C_RESET}"
    fi
  done
  echo ""
}

# --- Command: Install (Aliases) ---
cmd_install() {
  local bin_path="$MINDSET_HOME/bin/mindset"
  chmod +x "$bin_path"

  echo -e "\n${sym_bolt} ${C_BOLD}Shell integrations installed${C_RESET}"

  local zsh_bash_alias="alias mindset=\"$bin_path\""
  local fish_alias="alias mindset '$bin_path'"

  # Zsh
  local zshrc="$HOME/.zshrc"
  touch "$zshrc"
  if ! grep -qs "alias mindset=" "$zshrc"; then
    echo -e "\n# Mindset CLI\n$zsh_bash_alias" >> "$zshrc"
  fi
  echo -e "  ${sym_node} zsh  ${sym_active} ${C_DIM}~/.zshrc${C_RESET}"

  # Fish
  local fish_conf="$HOME/.config/fish/config.fish"
  if [[ -d "$HOME/.config/fish" ]] || which fish >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/fish"
    touch "$fish_conf"
    if ! grep -qs "alias mindset" "$fish_conf"; then
      echo -e "\n# Mindset CLI\n$fish_alias" >> "$fish_conf"
    fi
    echo -e "  ${sym_node} fish ${sym_active} ${C_DIM}~/.config/fish/config.fish${C_RESET}"
  fi
  echo ""
}

# --- Command: Uninstall (Remove Aliases) ---
cmd_uninstall() {
  echo -e "\n${sym_bolt} ${C_BOLD}Shell integrations removed${C_RESET}"

  # Zsh
  local zshrc="$HOME/.zshrc"
  if [[ -f "$zshrc" ]]; then
    sed -i.bak '/# Mindset CLI/d' "$zshrc" 2>/dev/null || true
    sed -i.bak '/alias mindset=/d' "$zshrc" 2>/dev/null || true
    rm -f "${zshrc}.bak"
    echo -e "  ${sym_node} zsh  ${sym_inactive} ${C_DIM}~/.zshrc${C_RESET}"
  fi

  # Fish
  local fish_conf="$HOME/.config/fish/config.fish"
  if [[ -f "$fish_conf" ]]; then
    sed -i.bak '/# Mindset CLI/d' "$fish_conf" 2>/dev/null || true
    sed -i.bak '/alias mindset/d' "$fish_conf" 2>/dev/null || true
    rm -f "${fish_conf}.bak"
    echo -e "  ${sym_node} fish ${sym_inactive} ${C_DIM}~/.config/fish/config.fish${C_RESET}"
  fi

  # Bash
  for rc in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [[ -f "$rc" ]]; then
      sed -i.bak '/# Mindset CLI/d' "$rc" 2>/dev/null || true
      sed -i.bak '/alias mindset=/d' "$rc" 2>/dev/null || true
      rm -f "${rc}.bak"
    fi
  done
  echo ""
}

# --- Help ---
show_help() {
  echo -e "\n${sym_bolt} ${C_BOLD}Mindset CLI${C_RESET}"
  echo -e "  mindset [provider]         ${C_DIM}Sync to project (default: antigravity)${C_RESET}"
  echo -e "  mindset unsync [provider]  ${C_DIM}Remove from project${C_RESET}"
  echo -e "  mindset status             ${C_DIM}View status in project${C_RESET}"
  echo -e "  mindset list               ${C_DIM}List agents in vault${C_RESET}"
  echo -e "  mindset install            ${C_DIM}Install shell aliases (Zsh, Fish)${C_RESET}"
  echo -e "  mindset uninstall          ${C_DIM}Remove shell aliases (Zsh, Fish)${C_RESET}\n"
}

# --- CLI Router ---
case "${1:-}" in
  install)
    cmd_install
    ;;
  uninstall)
    cmd_uninstall
    ;;
  unsync|unlink)
    cmd_unsync "${2:-antigravity}"
    ;;
  status)
    cmd_status
    ;;
  list|agents)
    cmd_list
    ;;
  help|--help|-h)
    show_help
    ;;
  sync)
    cmd_sync "${2:-antigravity}"
    ;;
  antigravity|cursor|claude)
    cmd_sync "$1"
    ;;
  "")
    cmd_sync "antigravity"
    ;;
  *)
    echo -e "\n${sym_bolt} ${C_RED}Unknown command '$1'${C_RESET}"
    show_help
    exit 1
    ;;
esac
