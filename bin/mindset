#!/usr/bin/env bash
set -euo pipefail

# Dynamically resolve the Mindset root directory (parent of bin/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MINDSET_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

# --- ANSI Color Palette ---
C_YELLOW="\033[33;1m"
C_CYAN="\033[36;1m"
C_GREEN="\033[32;1m"
C_RED="\033[31;1m"
C_DIM="\033[90m"
C_BOLD="\033[1m"
C_RESET="\033[0m"

# Formatting helpers
sym_bolt="${C_YELLOW}⚡${C_RESET}"
sym_node="${C_CYAN}◈${C_RESET}"
sym_active="${C_DIM}──${C_RESET}${C_GREEN}●${C_RESET}"
sym_inactive="${C_DIM}──○${C_RESET}"

SUPPORTED_PROVIDERS=("gemini" "claude" "codex" "grok")

# Convert absolute path to ~/relative for clean display
clean_path() {
  local path="$1"
  if [[ "$path" == "$HOME"* ]]; then
    echo "~${path#$HOME}"
  else
    echo "$path"
  fi
}

# --- Provider Target Root Mapping ---
# Each provider expects its agents and skills inside its specific project directory:
# gemini (or antigravity) -> .agents/ (or .gemini/)
# claude                 -> .claude/
# codex                  -> .codex/
# grok                   -> .grok/
get_provider_root() {
  case "$1" in
    gemini|antigravity) echo ".agents" ;;
    claude)             echo ".claude" ;;
    codex)              echo ".codex" ;;
    grok)               echo ".grok" ;;
    *)                  echo "" ;;
  esac
}

get_project_root() {
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
  else
    pwd
  fi
}

count_items() {
  local dir="$1"
  local type="${2:-f}"
  if [[ -d "$dir" ]]; then
    if [[ "$type" == "d" ]]; then
      find "$dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' '
    else
      find "$dir" -maxdepth 1 -name "*.md" 2>/dev/null | wc -l | tr -d ' '
    fi
  else
    echo "0"
  fi
}

# --- Git Stealth Protection (Silent Default) ---
ensure_git_excluded() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -d "$project_root/.git" ]]; then
    mkdir -p "$(dirname "$exclude_file")"
    if ! grep -qs "^${target_rel}" "$exclude_file" 2>/dev/null; then
      echo "" >> "$exclude_file"
      echo "# [mindset] Local developer AI preferences (untracked)" >> "$exclude_file"
      echo "${target_rel}/" >> "$exclude_file"
      echo "${target_rel}" >> "$exclude_file"
    fi
  fi
}

remove_git_exclusion() {
  local project_root="$1"
  local target_rel="$2"
  local exclude_file="$project_root/.git/info/exclude"

  if [[ -f "$exclude_file" ]]; then
    sed -i.bak "/# \[mindset\]/d" "$exclude_file" 2>/dev/null || true
    sed -i.bak "\|^${target_rel}/?\$|d" "$exclude_file" 2>/dev/null || true
    rm -f "${exclude_file}.bak"
  fi
}

# Link a single category (agents or skills) safely
safe_link_dir() {
  local src="$1"
  local dest="$2"

  mkdir -p "$(dirname "$dest")"

  if [[ -L "$dest" ]]; then
    local current
    current="$(readlink "$dest")"
    if [[ "$current" != "$src" ]]; then
      ln -sfn "$src" "$dest"
    fi
  elif [[ -d "$dest" ]]; then
    # Merge mode without overwriting existing files
    for item in "$src"/*; do
      if [[ -e "$item" ]]; then
        local iname
        iname="$(basename "$item")"
        if [[ ! -e "$dest/$iname" ]]; then
          ln -s "$item" "$dest/$iname"
        fi
      fi
    done
  else
    ln -s "$src" "$dest"
  fi
}

# --- Command: Sync Single Provider ---
sync_provider() {
  local provider="$1"
  local p_root
  p_root="$(get_provider_root "$provider")"

  if [[ -z "$p_root" ]]; then
    echo -e "  ${sym_node} ${provider} ${sym_inactive} ${C_RED}unknown provider${C_RESET}"
    return 1
  fi

  local project_root
  project_root="$(get_project_root)"

  local agents_src="$MINDSET_HOME/agents"
  local skills_src="$MINDSET_HOME/skills"

  local agents_dest="$project_root/$p_root/agents"
  local skills_dest="$project_root/$p_root/skills"

  # Link agents and skills
  if [[ -d "$agents_src" ]]; then
    safe_link_dir "$agents_src" "$agents_dest"
  fi

  if [[ -d "$skills_src" ]]; then
    safe_link_dir "$skills_src" "$skills_dest"
  fi

  # Apply silent git exclusion
  ensure_git_excluded "$project_root" "$p_root"

  local a_count s_count
  a_count=$(count_items "$agents_src" "f")
  local s_count
  s_count=$(count_items "$skills_src" "d")

  echo -e "  ${sym_node} ${provider} ${sym_active} ${C_GREEN}synced${C_RESET} ${C_DIM}(${a_count} agents, ${s_count} skills)${C_RESET}"
}

cmd_sync() {
  local target_provider="${1:-gemini}"
  local project_root
  project_root="$(get_project_root)"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${sym_bolt} ${C_BOLD}Syncing my mindset to${C_RESET} ${display_root}"

  if [[ "$target_provider" == "all" || "$target_provider" == "--all" ]]; then
    for p in "${SUPPORTED_PROVIDERS[@]}"; do
      sync_provider "$p"
    done
  else
    sync_provider "$target_provider"
  fi
  echo ""
}

# --- Command: Status ---
cmd_status() {
  local project_root
  project_root="$(get_project_root)"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${sym_bolt} ${C_BOLD}My mindset status in${C_RESET} ${display_root}"

  local a_count s_count
  a_count=$(count_items "$MINDSET_HOME/agents" "f")
  s_count=$(count_items "$MINDSET_HOME/skills" "d")

  for p in "${SUPPORTED_PROVIDERS[@]}"; do
    local p_root
    p_root="$(get_provider_root "$p")"
    local a_dest="$project_root/$p_root/agents"
    local s_dest="$project_root/$p_root/skills"

    if [[ -e "$a_dest" || -e "$s_dest" ]]; then
      echo -e "  ${sym_node} ${p} ${sym_active} ${C_GREEN}in sync${C_RESET} ${C_DIM}(${a_count} agents, ${s_count} skills)${C_RESET}"
    else
      echo -e "  ${sym_node} ${p} ${sym_inactive} ${C_DIM}not synced${C_RESET}"
    fi
  done
  echo ""
}

# --- Command: Unsync Provider ---
unsync_provider() {
  local provider="$1"
  local p_root
  p_root="$(get_provider_root "$provider")"

  if [[ -z "$p_root" ]]; then
    echo -e "  ${sym_node} ${provider} ${sym_inactive} ${C_RED}unknown provider${C_RESET}"
    return 1
  fi

  local project_root
  project_root="$(get_project_root)"

  local a_dest="$project_root/$p_root/agents"
  local s_dest="$project_root/$p_root/skills"

  local removed=0

  if [[ -L "$a_dest" ]]; then rm "$a_dest"; removed=1; elif [[ -d "$a_dest" ]]; then find "$a_dest" -type l -exec rm {} +; removed=1; fi
  if [[ -L "$s_dest" ]]; then rm "$s_dest"; removed=1; elif [[ -d "$s_dest" ]]; then find "$s_dest" -type l -exec rm {} +; removed=1; fi

  # If parent provider folder is now empty, clean it up
  rmdir "$project_root/$p_root" 2>/dev/null || true
  remove_git_exclusion "$project_root" "$p_root"

  if [[ $removed -eq 1 ]]; then
    echo -e "  ${sym_node} ${provider} ${sym_inactive} ${C_DIM}unsynced${C_RESET}"
  else
    echo -e "  ${sym_node} ${provider} ${sym_inactive} ${C_DIM}not synced${C_RESET}"
  fi
}

cmd_unsync() {
  local target_provider="${1:-gemini}"
  local project_root
  project_root="$(get_project_root)"
  local display_root
  display_root="$(clean_path "$project_root")"

  echo -e "\n${sym_bolt} ${C_BOLD}Unsyncing my mindset from${C_RESET} ${display_root}"

  if [[ "$target_provider" == "all" || "$target_provider" == "--all" ]]; then
    for p in "${SUPPORTED_PROVIDERS[@]}"; do
      unsync_provider "$p"
    done
  else
    unsync_provider "$target_provider"
  fi
  echo ""
}

# --- Command: List Agents & Skills ---
cmd_list() {
  local agents_dir="$MINDSET_HOME/agents"
  local skills_dir="$MINDSET_HOME/skills"

  echo -e "\n${sym_bolt} ${C_BOLD}Agents in${C_RESET} ${C_DIM}$(clean_path "$agents_dir")${C_RESET}"
  if [[ -d "$agents_dir" ]]; then
    for f in "$agents_dir"/*.md; do
      if [[ -f "$f" ]]; then
        local base name
        base="$(basename "$f")"
        name=$(grep -E "^name:" "$f" 2>/dev/null | head -n1 | sed -E 's/name:[[:space:]]*//' || echo "$base")
        echo -e "  ${sym_node} ${C_BOLD}${name}${C_RESET} ${C_DIM}── ${base}${C_RESET}"
      fi
    done
  fi

  echo -e "\n${sym_bolt} ${C_BOLD}Skills in${C_RESET} ${C_DIM}$(clean_path "$skills_dir")${C_RESET}"
  if [[ -d "$skills_dir" ]]; then
    for d in "$skills_dir"/*; do
      if [[ -d "$d" ]]; then
        local sname
        sname="$(basename "$d")"
        echo -e "  ${sym_node} ${C_BOLD}${sname}${C_RESET} ${C_DIM}── SKILL.md${C_RESET}"
      fi
    done
  fi
  echo ""
}

# --- Command: Install (Aliases) ---
cmd_install() {
  local bin_path="$MINDSET_HOME/bin/mindset"
  chmod +x "$bin_path"

  echo -e "\n${sym_bolt} ${C_BOLD}Shell integrations installed${C_RESET}"

  local zsh_bash_alias="alias mindset=\"$bin_path\""
  local fish_alias="alias mindset '$bin_path'"

  # Zsh
  local zshrc="$HOME/.zshrc"
  touch "$zshrc"
  if ! grep -qs "alias mindset=" "$zshrc"; then
    echo -e "\n# Mindset CLI\n$zsh_bash_alias" >> "$zshrc"
  fi
  echo -e "  ${sym_node} zsh  ${sym_active} ${C_DIM}~/.zshrc${C_RESET}"

  # Fish
  local fish_conf="$HOME/.config/fish/config.fish"
  if [[ -d "$HOME/.config/fish" ]] || which fish >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/fish"
    touch "$fish_conf"
    if ! grep -qs "alias mindset" "$fish_conf"; then
      echo -e "\n# Mindset CLI\n$fish_alias" >> "$fish_conf"
    fi
    echo -e "  ${sym_node} fish ${sym_active} ${C_DIM}~/.config/fish/config.fish${C_RESET}"
  fi
  echo ""
}

# --- Command: Uninstall (Remove Aliases) ---
cmd_uninstall() {
  echo -e "\n${sym_bolt} ${C_BOLD}Shell integrations removed${C_RESET}"

  # Zsh
  local zshrc="$HOME/.zshrc"
  if [[ -f "$zshrc" ]]; then
    sed -i.bak '/# Mindset CLI/d' "$zshrc" 2>/dev/null || true
    sed -i.bak '/alias mindset=/d' "$zshrc" 2>/dev/null || true
    rm -f "${zshrc}.bak"
    echo -e "  ${sym_node} zsh  ${sym_inactive} ${C_DIM}~/.zshrc${C_RESET}"
  fi

  # Fish
  local fish_conf="$HOME/.config/fish/config.fish"
  if [[ -f "$fish_conf" ]]; then
    sed -i.bak '/# Mindset CLI/d' "$fish_conf" 2>/dev/null || true
    sed -i.bak '/alias mindset/d' "$fish_conf" 2>/dev/null || true
    rm -f "${fish_conf}.bak"
    echo -e "  ${sym_node} fish ${sym_inactive} ${C_DIM}~/.config/fish/config.fish${C_RESET}"
  fi

  # Bash
  for rc in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [[ -f "$rc" ]]; then
      sed -i.bak '/# Mindset CLI/d' "$rc" 2>/dev/null || true
      sed -i.bak '/alias mindset=/d' "$rc" 2>/dev/null || true
      rm -f "${rc}.bak"
    fi
  done
  echo ""
}

# --- Help ---
show_help() {
  echo -e "\n${sym_bolt} ${C_BOLD}Mindset CLI${C_RESET}"
  echo -e "  mindset [provider]         ${C_DIM}Sync to project (default: gemini, or 'all')${C_RESET}"
  echo -e "  mindset sync [provider]    ${C_DIM}Explicit sync${C_RESET}"
  echo -e "  mindset unsync [provider]  ${C_DIM}Remove from project (or 'all')${C_RESET}"
  echo -e "  mindset status             ${C_DIM}View sync status across all providers${C_RESET}"
  echo -e "  mindset list               ${C_DIM}List all agents & skills in your vault${C_RESET}"
  echo -e "  mindset install            ${C_DIM}Install shell aliases (Zsh, Fish)${C_RESET}"
  echo -e "  mindset uninstall          ${C_DIM}Remove shell aliases (Zsh, Fish)${C_RESET}"
  echo -e "\n  ${C_BOLD}Supported Providers:${C_RESET} gemini (antigravity), claude, codex, grok, all\n"
}

# --- CLI Router ---
case "${1:-}" in
  install)
    cmd_install
    ;;
  uninstall)
    cmd_uninstall
    ;;
  unsync|unlink)
    cmd_unsync "${2:-gemini}"
    ;;
  status)
    cmd_status
    ;;
  list|agents|skills)
    cmd_list
    ;;
  help|--help|-h)
    show_help
    ;;
  sync)
    cmd_sync "${2:-gemini}"
    ;;
  gemini|antigravity|claude|codex|grok|all)
    cmd_sync "$1"
    ;;
  "")
    cmd_sync "gemini"
    ;;
  *)
    echo -e "\n${sym_bolt} ${C_RED}Unknown command or provider '$1'${C_RESET}"
    show_help
    exit 1
    ;;
esac
